<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="lww_customization.odoo_studio_res_comp_544f753f-34dd-4c31-a66d-08ecd86e773e" model="ir.ui.view" context="{'studio': True}" forcecreate="1">
    <field name="arch" type="xml">
      <data>
        <xpath expr="//list[1]/field[@name='name']" position="after">
          <field name="company_registry" optional="show"/>
        </xpath>
      </data>
    </field>
    <field name="inherit_id" ref="base.view_company_tree"/>
    <field name="mode">extension</field>
    <field name="model">res.company</field>
    <field name="name">Odoo Studio: res.company.list customization</field>
    <field name="priority">99</field>
    <field name="type">list</field>
  </record>
  <record id="lww_customization.odoo_studio_account__96fdb59e-2f30-4b20-b62a-68c5074eea79" model="ir.ui.view" context="{'studio': True}" forcecreate="1">
    <field name="arch" type="xml">
      <data>
        <xpath expr="//button[@name='action_invoice_approve']" position="attributes">
          <attribute name="groups">invoice_multi_approval.group_approve_manager</attribute>
          <attribute name="invisible">move_type not in ["out_invoice", "out_refund", "in_invoice", "in_refund"] or check_approve_ability != True or document_fully_approved == True or is_approved == True or not department_id</attribute>
        </xpath>
        <xpath expr="//form[1]/header[1]/button[@name='action_post'][2]" position="attributes">
          <attribute name="groups">account.group_account_invoice,purchase.group_purchase_user</attribute>
          <attribute name="invisible">hide_post_button or move_type == 'entry' or display_inactive_currency_warning</attribute>
        </xpath>
        <xpath expr="//form[1]/header[1]/button[@name='action_register_payment']" position="attributes">
          <attribute name="groups">account.group_account_user</attribute>
        </xpath>
        <xpath expr="//button[@name='action_reverse']" position="attributes">
          <attribute name="groups">account.group_account_user</attribute>
        </xpath>
        <xpath expr="//form[1]/header[1]/button[@name='button_cancel'][2]" position="attributes">
          <attribute name="groups">account.group_account_invoice,purchase.group_purchase_user</attribute>
        </xpath>
        <xpath expr="//button[@name='button_draft']" position="attributes">
          <attribute name="groups">account.group_account_user,purchase.group_purchase_user</attribute>
        </xpath>
        <xpath expr="//button[@name='button_draft']" position="after">
          <button string="Print Invoice" name="account.account_invoices_without_payment" type="action" class="oe_highlight" invisible="move_type not in [&quot;out_invoice&quot;, &quot;out_refund&quot;]"/>
        </xpath>
        <xpath expr="//field[@name='invoice_no']" position="attributes">
          <attribute name="required">True</attribute>
        </xpath>
        <xpath expr="//form[1]/sheet[1]/group[1]/group[2]/field[@name='invoice_date'][2]" position="attributes">
          <attribute name="force_save">0</attribute>
          <attribute name="readonly">False</attribute>
        </xpath>
        <xpath expr="//form[1]/sheet[1]/group[1]/group[2]/field[@name='date']" position="attributes">
          <attribute name="force_save">0</attribute>
          <attribute name="readonly">False</attribute>
        </xpath>
        <xpath expr="//field[@name='invoice_payment_term_id']" position="attributes">
          <attribute name="force_save">0</attribute>
          <attribute name="readonly">False</attribute>
        </xpath>
        <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='invoice_tab']/field[@name='invoice_line_ids']/list[1]/field[@name='account_id']" position="attributes">
          <attribute name="groups"/>
        </xpath>
        <xpath expr="//page[@name='aml_tab']" position="attributes">
          <attribute name="groups"/>
        </xpath>
        <xpath expr="//page[@name='approval_tab']" position="attributes">
          <attribute name="invisible">not department_id</attribute>
        </xpath>
      </data>
    </field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="mode">extension</field>
    <field name="model">account.move</field>
    <field name="name">Odoo Studio: account.move.form customization</field>
    <field name="priority">160</field>
    <field name="type">form</field>
  </record>
  <record id="lww_customization.odoo_studio_res_comp_f828cbb3-4df4-4bb7-8869-ef8f6f9ac274" model="ir.ui.view" context="{'studio': True}" forcecreate="1">
    <field name="arch" type="xml">
      <data>
        <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='general_info']/group[1]/group[1]/div[1]" position="after">
