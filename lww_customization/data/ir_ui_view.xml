  </record>
  <record id="lww_customization.odoo_studio_purchase_96d7b5c0-b598-4834-9e6a-f286fd9b6248" model="ir.ui.view" context="{'studio': True}" forcecreate="1">
    <field name="arch" type="xml">
      <data>
        <xpath expr="//form[1]/header[1]/button[@name='action_rfq_send']" position="attributes">
          <attribute name="groups">base.group_erp_manager</attribute>
        </xpath>
        <xpath expr="//form[1]/header[1]/button[@name='action_view_picking']" position="attributes">
          <attribute name="groups">hak_akses.group_admin_lww</attribute>
        </xpath>
        <xpath expr="//form[1]/header[1]/button[@name='button_confirm'][2]" position="attributes">
          <attribute name="groups">hak_purchase.group_purchase_admin_lww,purchase.group_purchase_manager,purchase_restricted_access.group_purchase_own_user</attribute>
        </xpath>
        <xpath expr="//button[@name='action_create_invoice']" position="attributes">
          <attribute name="groups">hak_purchase.group_purchase_admin_lww,purchase.group_purchase_manager,purchase_restricted_access.group_purchase_own_user</attribute>
        </xpath>
        <xpath expr="//button[@name='button_draft']" position="attributes">
          <attribute name="groups">purchase.group_purchase_user</attribute>
          <attribute name="invisible">state != "cancel"</attribute>
        </xpath>
        <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='products']/group[1]/group[1]/field[@name='notes']" position="before">
          <field name="discount_type"/>
          <field name="discount_rate"/>
        </xpath>
        <xpath expr="//field[@name='tax_totals']" position="before">
          <field name="amount_discount"/>
        </xpath>
      </data>
    </field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="mode">extension</field>
    <field name="model">purchase.order</field>
    <field name="name">Odoo Studio: purchase.order.form customization</field>
    <field name="priority">160</field>
    <field name="type">form</field>
  </record>
  <record id="lww_customization.odoo_studio_stock_pi_63cd364d-7882-4e89-b87b-5a94a98a75d1" model="ir.ui.view" context="{'studio': True}" forcecreate="1">
    <field name="arch" type="xml">
      <data>
        <xpath expr="//button[@name='action_assign']" position="attributes">
          <attribute name="groups">hak_akses.group_user_lww,stock.group_stock_user</attribute>
        </xpath>
        <xpath expr="//form[1]/header[1]/button[@name='button_validate']" position="attributes">
          <attribute name="groups">hak_akses.group_admin_lww,base.group_erp_manager</attribute>
        </xpath>
        <xpath expr="//form[1]/header[1]/button[@name='button_validate'][2]" position="attributes">
          <attribute name="groups">stock.group_stock_user,hak_akses.group_user_lww</attribute>
        </xpath>
        <xpath expr="//button[@name='action_cancel']" position="attributes">
