<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_wip_release" model="ir.module.category">
        <field name="name">WIP Release</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_wip_release" model="res.groups">
        <field name="name">WIP Release</field>
        <field name="category_id" ref="module_category_wip_release"/>
        <field name="comment">Allows monitoring and executing project WIP release, including manual override.</field>
    </record>

    <record id="wip_release_config_rule_company" model="ir.rule">
        <field name="name">WIP Release Config: multi company</field>
        <field name="model_id" ref="model_wip_release_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="wip_release_batch_rule_global" model="ir.rule">
        <field name="name">WIP Release Batch: cross company</field>
        <field name="model_id" ref="model_wip_release_batch"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="wip_release_line_rule_company" model="ir.rule">
        <field name="name">WIP Release Line: multi company</field>
        <field name="model_id" ref="model_wip_release_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="sale_contract_revision_rule_company" model="ir.rule">
        <field name="name">Sale Contract Revision: multi company</field>
        <field name="model_id" ref="model_sale_contract_revision"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
