<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_contract_revision_list" model="ir.ui.view">
        <field name="name">sale.contract.revision.list</field>
        <field name="model">sale.contract.revision</field>
        <field name="arch" type="xml">
            <list string="Contract Revisions" editable="bottom" create="false" delete="false">
                <field name="revision_date" readonly="1"/>
                <field name="order_id" readonly="1" optional="show"/>
                <field name="company_id" readonly="1" optional="hide" groups="base.group_multi_company"/>
                <field name="old_value" readonly="1"/>
                <field name="new_value" readonly="1"/>
                <field name="difference" readonly="1" optional="show"/>
                <field name="user_id" readonly="1"/>
                <field name="reason" placeholder="Reason is required before WIP release"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_sale_contract_revision" model="ir.actions.act_window">
        <field name="name">Contract Revisions</field>
        <field name="res_model">sale.contract.revision</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
