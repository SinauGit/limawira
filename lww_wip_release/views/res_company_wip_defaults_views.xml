<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_company_wip_defaults_list" model="ir.ui.view">
        <field name="name">res.company.wip.defaults.list</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <list string="WIP Release Defaults" editable="bottom" create="false" delete="false">
                <field name="name" readonly="1"/>
                <field name="x_default_wip_account_id" options="{'no_create': True}"/>
                <field name="x_default_cogs_account_id" options="{'no_create': True}"/>
                <field name="x_default_wip_journal_id" options="{'no_create': True}"/>
                <field name="x_default_release_threshold"/>
            </list>
        </field>
    </record>

    <record id="action_res_company_wip_defaults" model="ir.actions.act_window">
        <field name="name">WIP Release Defaults</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_res_company_wip_defaults_list"/>
    </record>
</odoo>
