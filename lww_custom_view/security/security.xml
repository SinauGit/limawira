<odoo>
    <data>
        <record id="purchase_order_personal_rule" model="ir.rule">
            <field name="name">Purchase Order: Personal Only</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), ('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_purchase_personal_only'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="purchase_order_department_rule" model="ir.rule">
            <field name="name">Purchase Order: Department Only</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('user_id.employee_id.department_id', '=', user.employee_id.department_id.id), ('user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_purchase_department_only'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="purchase_order_line_personal_rule" model="ir.rule">
            <field name="name">Purchase Order Line: Personal Only</field>
            <field name="model_id" ref="purchase.model_purchase_order_line"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), ('order_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_purchase_personal_only'))]"/>
        </record>

        <record id="purchase_order_line_department_rule" model="ir.rule">
            <field name="name">Purchase Order Line: Department Only</field>
            <field name="model_id" ref="purchase.model_purchase_order_line"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('order_id.user_id.employee_id.department_id', '=', user.employee_id.department_id.id), ('order_id.user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_purchase_department_only'))]"/>
        </record>
    </data>
</odoo>