<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_custom_desc" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.custom.description</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            
            
            <xpath expr="//field[@name='order_line']/list//field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            
            
            <xpath expr="//field[@name='order_line']/list//field[@name='product_template_id']" position="after">
                <field name="custom_description" optional="show"/>
            </xpath>
        </field>
    </record>

            
    <record id="view_invoice_form_inherit_custom_desc" model="ir.ui.view">
        <field name="name">account.move.form.inherit.custom.description</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            
            
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            
            
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='product_id']" position="after">
                <field name="custom_description" optional="show"/>
            </xpath>
            
        </field>
    </record>


<!-- Tree view Sale Order / Quotation -->
<record id="view_order_tree_inherit_custom_desc" model="ir.ui.view">
    <field name="name">sale.order.tree.inherit.custom.description</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
    <field name="arch" type="xml">
        <xpath expr="//list//field[@name='no_so']" position="after">
            <field name="order_line_descriptions" optional="show"/>
        </xpath>
    </field>
</record>

<record id="view_order_tree_inherit_custom_desc_so" model="ir.ui.view">
    <field name="name">sale.order.tree.inherit.custom.description.so</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.sale_order_list_upload"/>
    <field name="arch" type="xml">
        <xpath expr="//list//field[@name='partner_id']" position="after">
            <field name="order_line_descriptions" optional="show"/>
        </xpath>
    </field>
</record>

</odoo>