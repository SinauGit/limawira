<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_cost_export_wizard_form" model="ir.ui.view">
        <field name="name">project.cost.export.wizard.form</field>
        <field name="model">project.cost.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Project Cost Report">
                <group invisible="state == 'done'">
                    <field name="project_id" readonly="context.get('default_project_id')"/>
                    <field name="state" invisible="1"/>
                </group>
                <group invisible="state != 'done'">
                    <field name="state" invisible="1"/>
                    <div class="alert alert-success" role="alert">
                        <strong>File created successfully!</strong>
                        <br/>
                        Click the Download button below to download the Excel file.
                    </div>
                    <field name="file_data" filename="file_name" readonly="1"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <footer>
                    <button name="action_export_excel" string="Export Excel" type="object" 
                            class="btn-primary" invisible="state == 'done'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_project_form_inherit_cost_export" model="ir.ui.view">
        <field name="name">project.project.form.inherit.cost.export</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_export_cost_report" 
                        string="Export Cost Report" 
                        type="object" 
                        class="oe_highlight"
                        icon="fa-file-excel-o"/>
            </xpath>
        </field>
    </record>
</odoo>