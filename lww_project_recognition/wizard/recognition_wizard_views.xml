<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lww_recognition_wizard_form" model="ir.ui.view">
        <field name="name">lww.recognition.wizard.form</field>
        <field name="model">lww.recognition.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="project_id"/>
                    <field name="mode" invisible="1"/>
                    <field name="current_year" options="{'enable_formatting': false}"/>
                    <field name="manual" invisible="mode == 'pending'"/>
                    <field name="new_year" invisible="mode == 'pending' or not manual" options="{'enable_formatting': false}"/>
                    <field name="impacted_count"/>
                    <field name="confirm" invisible="impacted_count == 0"/>
                </group>
                <footer>
                    <button string="Apply" name="action_apply" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
