<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lww_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.lww.recognition</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="x_accounting_status" invisible="not x_accounting_status"/>
                <field name="x_project_id" invisible="not x_project_id"/>
                <field name="x_recognition_year" invisible="not x_recognition_year"/>
                <field name="x_recognition_mode" invisible="not x_recognition_mode"/>
                <field name="x_has_return" invisible="not x_has_return"/>
                <field name="x_reclass_move_id" invisible="not x_reclass_move_id"/>
                <field name="x_backdated_move_id" invisible="not x_backdated_move_id"/>
                <field name="x_reclass_reversal_move_id" invisible="not x_reclass_reversal_move_id"/>
                <field name="x_backdated_reversal_move_id" invisible="not x_backdated_reversal_move_id"/>
            </xpath>
        </field>
    </record>
    <record id="lww_picking_list" model="ir.ui.view">
        <field name="name">stock.picking.list.lww.recognition</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="x_accounting_status" optional="show" widget="badge"/>
                <field name="x_recognition_year" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="lww_picking_search" model="ir.ui.view">
        <field name="name">stock.picking.search.lww.recognition</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="lww_awaiting" string="Recognition: Awaiting" domain="[('x_accounting_status', '=', 'awaiting')]"/>
                <filter name="lww_pending" string="Recognition: Pending" domain="[('x_accounting_status', '=', 'pending')]"/>
                <filter name="lww_recognized" string="Recognition: Recognized" domain="[('x_accounting_status', 'in', ['recognized', 'returned'])]"/>
                <filter name="lww_group_status" string="Recognition Status" context="{'group_by': 'x_accounting_status'}"/>
            </xpath>
        </field>
    </record>
    <record id="lww_picking_dashboard_pivot" model="ir.ui.view">
        <field name="name">stock.picking.pivot.lww.recognition</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="x_project_id" type="row"/>
                <field name="x_accounting_status" type="col"/>
            </pivot>
        </field>
    </record>
    <record id="lww_picking_dashboard_action" model="ir.actions.act_window">
        <field name="name">DO Recognition</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="domain">[('x_accounting_status', '!=', False)]</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('stock.vpicktree')}), (0, 0, {'view_mode': 'pivot', 'view_id': ref('lww_picking_dashboard_pivot')}), (0, 0, {'view_mode': 'form', 'view_id': ref('stock.view_picking_form')})]"/>
    </record>
</odoo>
