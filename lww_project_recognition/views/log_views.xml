<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lww_recognition_log_list" model="ir.ui.view">
        <field name="name">lww.recognition.log.list</field>
        <field name="model">lww.recognition.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date" string="Date"/>
                <field name="user_id"/>
                <field name="project_id"/>
                <field name="picking_id"/>
                <field name="action"/>
                <field name="old_year"/>
                <field name="new_year"/>
                <field name="move_ids" widget="many2many_tags"/>
                <field name="note"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="lww_recognition_log_search" model="ir.ui.view">
        <field name="name">lww.recognition.log.search</field>
        <field name="model">lww.recognition.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="picking_id"/>
                <field name="user_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_action" string="Action" context="{'group_by': 'action'}"/>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="lww_recognition_log_action" model="ir.actions.act_window">
        <field name="name">Recognition Audit Log</field>
        <field name="res_model">lww.recognition.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
