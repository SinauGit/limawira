<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lww_dashboard_form" model="ir.ui.view">
        <field name="name">lww.recognition.dashboard.form</field>
        <field name="model">lww.recognition.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard" create="0" edit="0" delete="0">
                <sheet>
                    <div class="d-flex flex-wrap gap-3">
                        <button name="action_awaiting" type="object" class="btn btn-light border p-3 text-start" style="min-width: 230px;">
                            <div class="text-muted"><i class="fa fa-hourglass-half me-2"/>Awaiting DO</div>
                            <field name="awaiting_count" class="fs-1 fw-bold d-block mb-0"/>
                        </button>
                        <button name="action_pending" type="object" class="btn btn-light border p-3 text-start" style="min-width: 230px;">
                            <div class="text-muted"><i class="fa fa-exclamation-triangle me-2"/>Pending DO</div>
                            <field name="pending_count" class="fs-1 fw-bold d-block mb-0"/>
                        </button>
                        <button name="action_recognized" type="object" class="btn btn-light border p-3 text-start" style="min-width: 230px;">
                            <div class="text-muted"><i class="fa fa-check me-2"/>Recognized DO</div>
                            <field name="recognized_count" class="fs-1 fw-bold d-block mb-0"/>
                        </button>
                        <button name="action_no_year" type="object" class="btn btn-light border p-3 text-start" style="min-width: 230px;">
                            <div class="text-muted"><i class="fa fa-calendar-times-o me-2"/>Projects Without Year</div>
                            <field name="no_year_count" class="fs-1 fw-bold d-block mb-0"/>
                        </button>
                        <button name="action_near" type="object" class="btn btn-light border p-3 text-start" style="min-width: 230px;">
                            <div class="text-muted"><i class="fa fa-line-chart me-2"/>Near Threshold</div>
                            <field name="near_count" class="fs-1 fw-bold d-block mb-0"/>
                        </button>
                        <button name="action_override" type="object" class="btn btn-light border p-3 text-start" style="min-width: 230px;">
                            <div class="text-muted"><i class="fa fa-pencil-square-o me-2"/>Manual Override</div>
                            <field name="override_count" class="fs-1 fw-bold d-block mb-0"/>
                        </button>
                        <button name="action_journals" type="object" class="btn btn-light border p-3 text-start" style="min-width: 230px;">
                            <div class="text-muted"><i class="fa fa-book me-2"/>Active Journals</div>
                            <field name="journal_count" class="fs-1 fw-bold d-block mb-0"/>
                        </button>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="lww_dashboard_server_action" model="ir.actions.server">
        <field name="name">Dashboard</field>
        <field name="model_id" ref="model_lww_recognition_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>
</odoo>
