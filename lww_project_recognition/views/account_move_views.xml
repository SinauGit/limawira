<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_recognition_list" model="ir.ui.view">
        <field name="name">account.move.recognition.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Recognition Journals" create="0" delete="0">
                <field name="date"/>
                <field name="lww_entry_type" widget="badge" string="Journal Type"/>
                <field name="name"/>
                <field name="lww_picking_id" string="Reference DO"/>
                <field name="lww_recognition_year"/>
                <field name="company_currency_id" column_invisible="True"/>
                <field name="amount_total_signed" string="Amount" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"/>
                <field name="create_uid" string="Created By"/>
                <field name="create_date" string="Created On"/>
            </list>
        </field>
    </record>

    <record id="view_move_form_recognition" model="ir.ui.view">
        <field name="name">account.move.form.recognition</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Project Recognition" name="lww_recognition" invisible="not lww_entry_type">
                    <group>
                        <group>
                            <field name="lww_entry_type"/>
                            <field name="lww_project_id"/>
                            <field name="lww_picking_id"/>
                        </group>
                        <group>
                            <field name="lww_recognition_year"/>
                            <field name="lww_origin_move_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
