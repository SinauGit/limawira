<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lww_recognition_config_list" model="ir.ui.view">
        <field name="name">lww.recognition.config.list</field>
        <field name="model">lww.recognition.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="journal_id"/>
                <field name="payable_account_id"/>
                <field name="down_payment_account_id"/>
                <field name="threshold"/>
                <field name="go_live_date"/>
            </list>
        </field>
    </record>
    <record id="lww_recognition_config_form" model="ir.ui.view">
        <field name="name">lww.recognition.config.form</field>
        <field name="model">lww.recognition.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="journal_id"/>
                        <field name="payable_account_id"/>
                        <field name="down_payment_account_id" required="1"/>
                        <field name="threshold"/>
                        <field name="go_live_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="lww_recognition_config_action" model="ir.actions.act_window">
        <field name="name">Project Recognition Settings</field>
        <field name="res_model">lww.recognition.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
