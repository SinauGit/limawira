<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lww_project_form" model="ir.ui.view">
        <field name="name">project.project.form.lww.recognition</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_lww_override" type="object" string="Override Recognition Year" groups="lww_project_recognition.group_recognition_manager" invisible="lww_auto_year"/>
                <button name="action_lww_process_pending" type="object" string="Process Pending DOs" groups="lww_project_recognition.group_recognition_manager" invisible="lww_pending_count == 0"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_lww_view_awaiting" type="object" class="oe_stat_button" icon="fa-hourglass-half" invisible="lww_awaiting_count == 0">
                    <field name="lww_awaiting_count" widget="statinfo" string="Awaiting DO"/>
                </button>
                <button name="action_lww_view_pending" type="object" class="oe_stat_button" icon="fa-exclamation-triangle" invisible="lww_pending_count == 0">
                    <field name="lww_pending_count" widget="statinfo" string="Pending DO"/>
                </button>
                <button name="action_lww_view_recognized" type="object" class="oe_stat_button" icon="fa-check" invisible="lww_recognized_count == 0">
                    <field name="lww_recognized_count" widget="statinfo" string="Recognized DO"/>
                </button>
                <button name="action_lww_view_moves" type="object" class="oe_stat_button" icon="fa-book" invisible="lww_move_count == 0">
                    <field name="lww_move_count" widget="statinfo" string="Recognition Journals"/>
                </button>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="DO Recognition" name="lww_recognition">
                    <field name="lww_rec_year" options="{'enable_formatting': false}"/>
                    <field name="lww_rec_mode"/>
                    <field name="lww_auto_year" options="{'enable_formatting': false}"/>
                    <field name="lww_auto_date"/>
                    <field name="lww_manual_override" readonly="1"/>
                    <field name="lww_override_year" readonly="1" invisible="not lww_manual_override" options="{'enable_formatting': false}"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="lww_project_dashboard_list" model="ir.ui.view">
        <field name="name">project.project.list.lww.recognition</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="lww_progress" string="Progress (%)"/>
                <field name="lww_rec_year" options="{'enable_formatting': false}"/>
                <field name="lww_rec_mode"/>
                <field name="lww_awaiting_count" string="Awaiting"/>
                <field name="lww_pending_count" string="Pending"/>
                <field name="lww_recognized_count" string="Recognized"/>
            </list>
        </field>
    </record>
    <record id="lww_project_dashboard_action" model="ir.actions.act_window">
        <field name="name">Project Recognition</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('lww_sale_order_id', '!=', False)]</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('lww_project_dashboard_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('project.edit_project')})]"/>
    </record>
</odoo>
