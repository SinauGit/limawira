<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================
             MODULE CATEGORY
        ============================================================ -->
        <record id="module_category_purchase_restricted" model="ir.module.category">
            <field name="name">Purchase Restricted</field>
            <field name="description">
                Grup akses terbatas untuk modul Purchase.
                Pengguna dalam kategori ini hanya dapat mengakses
                menu Request for Quotation dan Purchase Orders.
            </field>
            <field name="sequence">101</field>
            <field name="visible" eval="True"/>
        </record>


        <!-- ============================================================
             GROUP 1: PURCHASE USER - OWN RECORDS ONLY
             Hanya dapat melihat RFQ dan PO milik sendiri
        ============================================================ -->
        <record id="group_purchase_own_user" model="res.groups">
            <field name="name">Purchase User (Own Records)</field>
            <field name="category_id" ref="module_category_purchase_restricted"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Pengguna dalam grup ini hanya dapat melihat Request for Quotation
                dan Purchase Orders yang dibuat oleh mereka sendiri
                (berdasarkan Buyer/user_id atau pembuat/create_uid).
                Tidak dapat mengakses menu Purchase lainnya (Produk, Laporan, Konfigurasi).
            </field>
        </record>


        <!-- ============================================================
             GROUP 2: PURCHASE USER - DEPARTMENT RECORDS
             Dapat melihat RFQ dan PO seluruh anggota departemen
        ============================================================ -->
        <record id="group_purchase_department_user" model="res.groups">
            <field name="name">Purchase User (Department Records)</field>
            <field name="category_id" ref="module_category_purchase_restricted"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Pengguna dalam grup ini dapat melihat Request for Quotation
                dan Purchase Orders dari seluruh anggota departemen mereka.
                Filtering berdasarkan department_id dari employee yang terhubung ke user (via HR).
                Tidak dapat mengakses menu Purchase lainnya (Produk, Laporan, Konfigurasi).
            </field>
        </record>


        <!-- ============================================================
             RECORD RULES - purchase.order
        ============================================================ -->

        <!--
            RULE 1: Own Records Only
            Hanya tampilkan PO/RFQ dimana:
              - user_id (Buyer) = current user  ATAU
              - create_uid (pembuat) = current user
        -->
        <record id="rule_purchase_order_own_user" model="ir.rule">
            <field name="name">Purchase Order: Hanya Record Sendiri</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="groups" eval="[(4, ref('group_purchase_own_user'))]"/>
            <field name="domain_force">
                ['|',
                    ('user_id', '=', user.id),
                    ('create_uid', '=', user.id)
                ]
            </field>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!--
            RULE 2: Department Records
            Tampilkan PO/RFQ dimana Buyer berasal dari departemen yang sama.
            Fallback ke record sendiri jika user tidak memiliki departemen.

            Logic:
              ( buyer punya dept AND dept buyer = dept saya )
              ATAU
              ( saya adalah buyer / pembuat )
        -->
        <record id="rule_purchase_order_department_user" model="ir.rule">
            <field name="name">Purchase Order: Record Departemen</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="groups" eval="[(4, ref('group_purchase_department_user'))]"/>
            <field name="domain_force">
                ['|',
                    '&amp;',
                        ('user_id.employee_id.department_id', '!=', False),
                        ('user_id.employee_id.department_id', '=', user.employee_id.department_id.id),
                    '|',
                        ('user_id', '=', user.id),
                        ('create_uid', '=', user.id)
                ]
            </field>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>


        <!-- ============================================================
             RECORD RULES - purchase.order.line
             Mengikuti aturan yang sama dengan purchase.order
        ============================================================ -->

        <!-- Rule line: Own Records Only -->
        <record id="rule_purchase_order_line_own_user" model="ir.rule">
            <field name="name">Purchase Order Line: Hanya Record Sendiri</field>
            <field name="model_id" ref="purchase.model_purchase_order_line"/>
            <field name="groups" eval="[(4, ref('group_purchase_own_user'))]"/>
            <field name="domain_force">
                ['|',
                    ('order_id.user_id', '=', user.id),
                    ('order_id.create_uid', '=', user.id)
                ]
            </field>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Rule line: Department Records -->
        <record id="rule_purchase_order_line_department_user" model="ir.rule">
            <field name="name">Purchase Order Line: Record Departemen</field>
            <field name="model_id" ref="purchase.model_purchase_order_line"/>
            <field name="groups" eval="[(4, ref('group_purchase_department_user'))]"/>
            <field name="domain_force">
                ['|',
                    '&amp;',
                        ('order_id.user_id.employee_id.department_id', '!=', False),
                        ('order_id.user_id.employee_id.department_id', '=', user.employee_id.department_id.id),
                    '|',
                        ('order_id.user_id', '=', user.id),
                        ('order_id.create_uid', '=', user.id)
                ]
            </field>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
