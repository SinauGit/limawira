<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_purchase_bs" model="res.groups">
        <field name="name">Purchase BS</field>
        <field name="category_id" ref="base.module_category_inventory_purchase"/>
    </record>

    <record id="rule_purchase_order_bs_own" model="ir.rule">
        <field name="name">Purchase BS: own RFQ/PO</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[('create_uid','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('group_purchase_bs'))]"/>
    </record>

    <record id="rule_purchase_order_line_bs_own" model="ir.rule">
        <field name="name">Purchase BS: own RFQ/PO lines</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="domain_force">[('order_id.create_uid','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('group_purchase_bs'))]"/>
    </record>

    <record id="rule_account_move_bs_own" model="ir.rule">
        <field name="name">Purchase BS: own vendor bills</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[('create_uid','=',user.id),('move_type','in',('in_invoice','in_refund'))]</field>
        <field name="groups" eval="[(4, ref('group_purchase_bs'))]"/>
    </record>

    <record id="rule_account_move_line_bs_own" model="ir.rule">
        <field name="name">Purchase BS: own vendor bill lines</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="domain_force">[('move_id.create_uid','=',user.id),('move_id.move_type','in',('in_invoice','in_refund'))]</field>
        <field name="groups" eval="[(4, ref('group_purchase_bs'))]"/>
    </record>
</odoo>
