<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edit_project_inherit_stage_readonly" model="ir.ui.view">
        <field name="name">project.project.form.stage.readonly</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="groups_id" eval="[(4, ref('project_stage_restrict.group_project_user_no_stage'))]"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
