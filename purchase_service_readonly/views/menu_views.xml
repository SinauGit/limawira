<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── Actions ──────────────────────────────────────────────── -->

    <record id="action_rfq_service_readonly" model="ir.actions.act_window">
        <field name="name">Request for Quotation</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['draft', 'sent', 'cancel'])]</field>
        <field name="context">{'default_state': 'draft'}</field>
    </record>

    <record id="action_po_service_readonly" model="ir.actions.act_window">
        <field name="name">Purchase Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['purchase', 'done', 'cancel'])]</field>
    </record>

    <record id="action_vendor_bills_service" model="ir.actions.act_window">
        <field name="name">Bills</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'in_invoice')]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
    </record>

    <record id="action_vendors_service_readonly" model="ir.actions.act_window">
        <field name="name">Vendors</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('supplier_rank', '>', 0)]</field>
        <field name="context">{'default_supplier_rank': 1}</field>
    </record>

    <!-- ─── Root Menu ─────────────────────────────────────────────── -->

    <menuitem id="menu_purchase_service_root"
              name="Purchase"
              sequence="50"
              groups="sale_readonly_access.group_sale_readonly"
              web_icon="purchase,static/description/icon.png"/>

    <!-- ─── Orders Menu ───────────────────────────────────────────── -->

    <menuitem id="menu_purchase_service_orders"
              name="Orders"
              parent="menu_purchase_service_root"
              sequence="10"
              groups="sale_readonly_access.group_sale_readonly"/>

    <menuitem id="menu_purchase_service_rfq"
              name="Request for Quotation"
              parent="menu_purchase_service_orders"
              action="action_rfq_service_readonly"
              sequence="10"
              groups="sale_readonly_access.group_sale_readonly"/>

    <menuitem id="menu_purchase_service_po"
              name="Purchase Orders"
              parent="menu_purchase_service_orders"
              action="action_po_service_readonly"
              sequence="20"
              groups="sale_readonly_access.group_sale_readonly"/>

    <!-- ─── Vendors Menu ──────────────────────────────────────────── -->

    <menuitem id="menu_purchase_service_vendors_root"
              name="Vendors"
              parent="menu_purchase_service_root"
              sequence="20"
              groups="sale_readonly_access.group_sale_readonly"/>

    <menuitem id="menu_purchase_service_vendors"
              name="Vendors"
              parent="menu_purchase_service_vendors_root"
              action="action_vendors_service_readonly"
              sequence="10"
              groups="sale_readonly_access.group_sale_readonly"/>

    <menuitem id="menu_purchase_service_bills"
              name="Bills"
              parent="menu_purchase_service_vendors_root"
              action="action_vendor_bills_service"
              sequence="20"
              groups="sale_readonly_access.group_sale_readonly"/>

</odoo>
