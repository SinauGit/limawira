<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Extend Activity template untuk show multi assignees -->
    <t t-name="mail.Activity" t-inherit="mail.Activity" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'o_activity_user')]" position="after">
            <div t-if="hasMultipleAssignees" class="text-muted small">
                <i class="fa fa-users me-1"/>
                <span t-esc="assignedUsersDisplay"/>
            </div>
        </xpath>
    </t>
</templates>