<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_sale_readonly" model="res.groups">
        <field name="name">Read Only</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_sale_order_readonly_all" model="ir.rule">
        <field name="name">Read Only: all sale orders</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[(4, ref('group_sale_readonly'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_account_move_readonly_so" model="ir.rule">
        <field name="name">Read Only: invoices linked to sale orders</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="groups" eval="[(4, ref('group_sale_readonly'))]"/>
        <field name="domain_force">[('move_type', 'in', ('out_invoice', 'out_refund')), ('line_ids.sale_line_ids', '!=', False)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_account_move_line_readonly_so" model="ir.rule">
        <field name="name">Read Only: lines of customer invoices</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="groups" eval="[(4, ref('group_sale_readonly'))]"/>
        <field name="domain_force">[('move_id.move_type', 'in', ('out_invoice', 'out_refund'))]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
