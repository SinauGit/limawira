<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale.menu_sale_order" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('sale_readonly.group_sale_readonly'))]"/>
    </record>

    <record id="sale.menu_sale_invoicing" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('sale_readonly.group_sale_readonly'))]"/>
    </record>

    <record id="sale.product_menu_catalog" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('sale_readonly.group_sale_readonly'))]"/>
    </record>

    <record id="view_order_form_readonly" model="ir.ui.view">
        <field name="name">sale.order.form.readonly</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="groups_id" eval="[(4, ref('sale_readonly.group_sale_readonly'))]"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="create">false</attribute>
                <attribute name="edit">false</attribute>
                <attribute name="delete">false</attribute>
                <attribute name="duplicate">false</attribute>
            </xpath>
            <xpath expr="//button[@id='create_invoice']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@id='create_invoice_percentage']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@id='action_confirm']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_confirm'][not(@id)]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_order_tree_readonly" model="ir.ui.view">
        <field name="name">sale.order.list.readonly</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="groups_id" eval="[(4, ref('sale_readonly.group_sale_readonly'))]"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">false</attribute>
                <attribute name="edit">false</attribute>
                <attribute name="delete">false</attribute>
                <attribute name="duplicate">false</attribute>
            </xpath>
        </field>
    </record>

</odoo>
