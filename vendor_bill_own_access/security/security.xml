<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_kustom" model="ir.module.category">
        <field name="name">Kustom</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_vendor_bill_own_access" model="res.groups">
        <field name="name">User Own Bills</field>
        <field name="category_id" ref="module_category_kustom"/>
    </record>

    <record id="rule_vendor_bill_own_access_move" model="ir.rule">
        <field name="name">Vendor Bill: hanya bill milik sendiri</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[('create_uid','=',user.id),('move_type','in',['in_invoice','in_refund'])]</field>
        <field name="groups" eval="[(4, ref('group_vendor_bill_own_access'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>

    <record id="rule_vendor_bill_own_access_move_line" model="ir.rule">
        <field name="name">Vendor Bill Line: hanya line dari bill milik sendiri</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="domain_force">[('move_id.create_uid','=',user.id),('move_id.move_type','in',['in_invoice','in_refund'])]</field>
        <field name="groups" eval="[(4, ref('group_vendor_bill_own_access'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>
</odoo>
