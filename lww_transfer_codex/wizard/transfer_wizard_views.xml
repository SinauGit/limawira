<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_lww_transfer_wizard_form" model="ir.ui.view">
    <field name="name">lww.transfer.wizard.form</field>
    <field name="model">lww.transfer.wizard</field>
    <field name="arch" type="xml">
      <form string="Transfer Project &amp; Analytic (Codex)">
        <header>
          <button name="action_execute" string="Execute" type="object" class="oe_highlight" invisible="state != 'draft'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
        </header>
        <sheet>
          <group>
            <group string="Company">
              <field name="company_id" options="{'no_create': True, 'no_edit': True}"/>
            </group>
            <group string="Options">
              <field name="update_project"/>
              <field name="update_analytic"/>
            </group>
          </group>

          <group>
            <group string="Source (Filters)">
              <field name="source_project_id"/>
              <field name="source_analytic_id"/>
            </group>
            <group string="Target">
              <field name="target_project_id"/>
              <field name="target_analytic_id"/>
            </group>
          </group>
 
          <group string="Document Types">
            <field name="process_sales"/>
            <field name="process_purchase"/>
            <field name="process_invoices"/>
            <field name="process_expenses"/>
            <field name="process_stock"/>
          </group>

          <group invisible="state != 'done'">
            <field name="log_message" widget="html" nolabel="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_lww_transfer_wizard" model="ir.actions.act_window">
    <field name="name">Transfer Project &amp; Analytic (Codex)</field>
    <field name="res_model">lww.transfer.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="context">{}</field>
  </record>

</odoo>
