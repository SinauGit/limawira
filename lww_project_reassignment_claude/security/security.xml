<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Security Group -->
        <record id="group_project_analytic_transfer_user" model="res.groups">
            <field name="name">Project Analytic Transfer User</field>
            <field name="category_id" ref="base.module_category_project"/>
            <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        </record>

        <record id="group_project_analytic_transfer_manager" model="res.groups">
            <field name="name">Project Analytic Transfer Manager</field>
            <field name="category_id" ref="base.module_category_project"/>
            <field name="implied_ids" eval="[(4, ref('group_project_analytic_transfer_user')), (4, ref('project.group_project_manager'))]"/>
        </record>

        <!-- Multi-company Record Rules -->
        <record id="project_analytic_transfer_wizard_company_rule" model="ir.rule">
            <field name="name">Project Analytic Transfer: multi-company</field>
            <field name="model_id" ref="model_project_analytic_transfer_wizard"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_project_analytic_transfer_user'))]"/>
        </record>

    </data>
</odoo>