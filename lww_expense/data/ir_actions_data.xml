<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Action untuk User - hanya bill sendiri -->
        <record id="action_my_vendor_bills" model="ir.actions.act_window">
            <field name="name">My Vendor Bills</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('move_type', '=', 'in_invoice'), ('create_uid', '=', uid)]</field>
            <field name="context">{
                'default_move_type': 'in_invoice',
                'move_type': 'in_invoice',
                'journal_type': 'purchase'
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No vendor bills found.
                </p>
                <p>
                    Create your first vendor bill by clicking on the "Create" button.
                    You can only see the bills that you created.
                </p>
            </field>
        </record>

        <!-- Action untuk Manager - semua bill departemen -->
        <record id="action_department_vendor_bills" model="ir.actions.act_window">
            <field name="name">Department Vendor Bills</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('move_type', '=', 'in_invoice')]</field>
            <field name="context">{
                'default_move_type': 'in_invoice',
                'move_type': 'in_invoice',
                'journal_type': 'purchase'
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No vendor bills found for your department.
                </p>
                <p>
                    Create your first vendor bill by clicking on the "Create" button.
                    As a manager, you can see all bills from your department.
                </p>
            </field>
        </record>

        <!-- Action untuk Vendor Refunds -->
