<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Extend tree view untuk menampilkan department dan expense indicator -->
        <record id="view_department_vendor_bill_tree" model="ir.ui.view">
            <field name="name">Department Expense Bills Tree</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_partner_display_name']" position="after">
                    <field name="is_expense_bill" string="Expense Bill" widget="boolean_toggle" optional="hide"/>
                    <field name="department_id" string="Department" optional="hide"/>
                    <field name="create_uid" string="Created By" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="invoice_no" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='invoice_no']" position="after">
                                <field name="employee_id" optional="hide"/>
                            </xpath>
                <xpath expr="//field[@name='status_in_payment']" position="before">
                                <field name="document_fully_approved" string="Is Approved ?" column_invisible="not department_id" optional="show"/>
                            </xpath>
            </field>
        </record>

        <!-- Extend form view untuk menampilkan department dan expense indicator -->
        <record id="view_department_vendor_bill_form" model="ir.ui.view">
            <field name="name">Department Expense Bills Form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='company_id']" position="attributes">
                    <attribute name="readonly">is_expense_bill</attribute>
                    <attribute name="force_save">1</attribute>
                </xpath>

                <xpath expr="//field[@name='ref']" position="after">
                    <field name="is_expense_bill" invisible="1"/>
                    <field name="department_id" readonly="1" invisible="not is_expense_bill"/>
                </xpath>
                <xpath expr="//field[@name='ref']" position="after">
                    <field name="create_uid" string="Created By" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='invoice_no']" position="after">
                                <field name="employee_id" invisible="not is_expense_bill"/>
                            </xpath>
                <xpath expr="//field[@name='department_id']" position="after">
                    <field name="company_id" invisible="1"
                        groups="base.group_multi_company"
                        options="{'no_create': True}"/>
                </xpath>

                <!-- Add expense badge in header if this is expense bill -->
                <!-- <xpath expr="//div[hasclass('oe_title')]//h1" position="after">
                    <span class="badge badge-warning" invisible="not is_expense_bill">Expense Bill</span>
                </xpath> -->
            </field>
        </record>

        <!-- Search view dengan filter department dan expense bills -->
        <record id="view_department_vendor_bill_search" model="ir.ui.view">
            <field name="name">Department Expense Bills Search</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='late']" position="after">
                    <separator/>
                    <filter string="My Bills" name="my_bills" domain="[('create_uid', '=', uid)]"/>
                    <filter string="Expense Bills" name="expense_bills" domain="[('is_expense_bill', '=', True)]"/>
                </xpath>
                <xpath expr="//group" position="inside">
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Created By" name="group_created_by" context="{'group_by': 'create_uid'}"/>
                    <filter string="Is Expense" name="group_is_expense" context="{'group_by': 'is_expense_bill'}"/>
                </xpath>
            </field>
        </record>

