        <!-- MANAGER RULES: Department expense bills only -->
        <record id="rule_vendor_bill_manager_department" model="ir.rule">
            <field name="name">Expense Bills: Manager Department Access</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[
                ('is_expense_bill', '=', True),
                ('move_type', '=', 'in_invoice'),
                ('department_id', '=', user.employee_id.department_id.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_department_bill_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>


        <!-- ADMIN RULES: All expense bills -->
        <record id="rule_vendor_bill_admin_all" model="ir.rule">
            <field name="name">Expense Bills: Admin All Access</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[
                ('is_expense_bill', '=', True),
                ('move_type', '=', 'in_invoice')
            ]</field>
            <field name="groups" eval="[(4, ref('group_department_bill_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>


