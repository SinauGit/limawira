<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Security Groups -->
        <record id="group_department_bill_user" model="res.groups">
            <field name="name">Department Expense Bill User</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="comment">User can create and view only their own expense bills</field>
        </record>
        
        <record id="group_department_bill_manager" model="res.groups">
            <field name="name">Department Expense Bill Manager</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="comment">Manager can access all expense bills from their department</field>
        </record>

        <record id="group_department_bill_admin" model="res.groups">
            <field name="name">Department Expense Bill Admin</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="comment">Admin can access all expense bills from all departments</field>
        </record>


        <!-- USER RULES: Own expense bills only (draft + posted) -->
        <record id="rule_vendor_bill_user_own" model="ir.rule">
            <field name="name">Expense Bills: User Own Bills</field>    
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[
                ('is_expense_bill', '=', True),
                ('move_type', '=', 'in_invoice'),
                ('create_uid', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_department_bill_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- USER RULES: Restrict write to draft only -->
