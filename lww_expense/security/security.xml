<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Security Groups TANPA Hierarchy -->
        <record id="group_department_bill_user" model="res.groups">
            <field name="name">Department Vendor Bill User</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="comment">User can access only their own vendor bills</field>
        </record>
        
        <record id="group_department_bill_manager" model="res.groups">
            <field name="name">Department Vendor Bill Manager</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="comment">Manager can access all vendor bills from their department</field>
        </record>

        <record id="group_department_bill_admin" model="res.groups">
            <field name="name">Department Vendor Bill Admin</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="comment">Admin can access all department vendor bills</field>
        </record>


        <record id="rule_vendor_bill_user_own" model="ir.rule">
        <field name="name">Vendor Bills: User Own Bills Only</field>    
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[
            ('move_type', '=', 'in_invoice')
        ]</field>
        <field name="groups" eval="[(4, ref('group_department_bill_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        </record>


        <record id="rule_vendor_bill_manager_department" model="ir.rule">
            <field name="name">Vendor Bills: Manager Department Access</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[
                ('department_id', '=', user.employee_id.department_id.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_department_bill_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_vendor_bill_admin_all" model="ir.rule">
        <field name="name">Vendor Bills: Admin All Departments</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[
            ('move_type', '=', 'in_invoice'),
            ('state', '=', 'posted')
        ]</field>
        <field name="groups" eval="[(4, ref('group_department_bill_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        </record>


    </data>
</odoo>